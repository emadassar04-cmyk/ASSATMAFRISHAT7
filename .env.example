# ==============================================
# .env.example — مفروشات العصار
# انسخ إلى .env.local محلياً. في الإنتاج: Vercel Environment Variables فقط.
# لا تضع قيماً حقيقية هنا أبداً.
# ==============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=[SUPABASE_URL]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[SUPABASE_PUBLISHABLE_KEY]
# للخادم فقط — لا يبدأ بـ NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# تسجيل الدخول عبر Google: يُضبط في لوحة Supabase (Auth → Providers → Google)، لا متغيرات هنا.

# --- n8n (الموقع <-> n8n) ---
N8N_BASE_URL=[https://n8n.example.com]
# مفتاح HMAC لتوقيع Webhooks الصادرة من الموقع إلى n8n
N8N_OUTBOUND_HMAC_SECRET=[RANDOM_64_HEX]
# مفتاح HMAC للتحقق من Webhooks الواردة من n8n إلى الموقع
N8N_INBOUND_HMAC_SECRET=[RANDOM_64_HEX]
# سر مهمة إعادة المحاولة (Vercel Cron)
CRON_SECRET=[RANDOM_64_HEX]

# --- Meta (فيسبوك / واتساب) — تُستخدم داخل n8n credentials؛ تُذكر هنا للتوثيق ---
META_APP_ID=[META_APP_ID]
META_APP_SECRET=[META_APP_SECRET]
META_VERIFY_TOKEN=[WEBHOOK_VERIFY_TOKEN]
FB_PAGE_ID=[FB_PAGE_ID]
FB_PAGE_ACCESS_TOKEN=[FB_PAGE_ACCESS_TOKEN]
WHATSAPP_PHONE_NUMBER_ID=[PHONE_NUMBER_ID]
WHATSAPP_BUSINESS_ACCOUNT_ID=[WABA_ID]
WHATSAPP_ACCESS_TOKEN=[WHATSAPP_TOKEN]
NEXT_PUBLIC_META_PIXEL_ID=[PIXEL_ID]

# --- Telegram ---
TELEGRAM_BOT_TOKEN=[TELEGRAM_BOT_TOKEN]
TELEGRAM_WEBHOOK_SECRET=[RANDOM_SECRET_TOKEN]
TELEGRAM_STAFF_GROUP_ID=[STAFF_GROUP_CHAT_ID]
TELEGRAM_ADMIN_CHAT_ID=[ADMIN_CHAT_ID]
TELEGRAM_OFFERS_CHANNEL_ID=[CHANNEL_ID]

# --- AI (اختر مزوداً واحداً — قرار معلّق) ---
AI_PROVIDER=[openai|gemini]
OPENAI_API_KEY=[OPENAI_KEY]
GEMINI_API_KEY=[GEMINI_KEY]

# --- الموقع ---
NEXT_PUBLIC_SITE_URL=[https://example.com]
